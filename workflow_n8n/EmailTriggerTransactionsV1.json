    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Obtenemos el cuerpo del correo (texto plano) y el asunto\nconst cuerpo = item.json.text || \"\";\nconst asunto = item.json.subject || \"Gasto sin asunto\";\n\n// 1. Buscamos el monto usando Expresiones Regulares (Regex)\n// Busca patrones como: \"Total: 500\", \"Monto: $500.00\", \"500 MXN\"\n// La regex captura números decimales o enteros\nconst regexMonto = /(?:Total|Monto|Importe)[:\\s$]*([\\d,]+(?:\\.\\d{1,2})?)/i;\nconst match = cuerpo.match(regexMonto);\n\nlet monto = 0.0;\nlet descripcion = asunto;\n\nif (match && match[1]) {\n  // Limpiamos comas (ej: 1,200.50 -> 1200.50)\n  monto = parseFloat(match[1].replace(',', ''));\n  descripcion += \" (Auto-detectado)\";\n} else {\n  // Si no encuentra monto, ponemos 0 para revisarlo manual despues\n  descripcion += \" [REVISAR: No se halló monto]\";\n}\n\n// LÓGICA DE CLASIFICACIÓN\n// Asumimos IDs de tu BD: 1=Efectivo, 2=Nu, 3=BBVA\nlet cuenta_id = 1;       // Default (Efectivo)\nlet categoria_id = 1;    // Default (Gastos Varios)\nlet deuda_id = null;     // Por defecto no es pago de deuda\n\n// Normalizamos a minúsculas para buscar fácil\nconst textoBusqueda = (asunto + \" \" + cuerpo).toLowerCase();\n\nif (textoBusqueda.includes(\"nu\")) {\n    cuenta_id = 2; // ID de tu tarjeta Nu\n    descripcion = \"Gasto Tarjeta Nu: \" + descripcion;\n    \n    // Ejemplo: Si dice \"estado de cuenta\", quizás es un pago de deuda\n    if (textoBusqueda.includes(\"estado de cuenta\")) {\n       categoria_id = 10; // ID para \"Pago de Deudas\"\n       deuda_id = 5;      // ID de tu deuda Nu específica\n    }\n\n} else if (textoBusqueda.includes(\"bbva\")) {\n    cuenta_id = 3; // ID de tu cuenta BBVA\n    \n} else if (textoBusqueda.includes(\"cfe\") || textoBusqueda.includes(\"internet\")) {\n    categoria_id = 3; // ID Servicios\n}\n\nreturn {\n  json: {\n    monto: monto,\n    descripcion: descripcion,\n    tipo: 'EGRESO',\n    cuenta_id: cuenta_id,\n    categoria_id: categoria_id,\n    deuda_id: deuda_id // <--- Nuevo campo para enviar a Postgres\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
